    "from astroquery.mast import MastMissions\n",
    "from astropy.coordinates import SkyCoord\n",
    "\n",
    "mm = MastMissions(mission='jwst')\n",
    "target = SkyCoord.from_name('TRAPPIST-1')\n",
    "mm.query_region(target, radius='1 arcmin')"
   ]
